{
  "name": "@perryts/play-billing",
  "version": "0.1.1",
  "description": "Google Play Billing Library bindings (Android) for the Perry TypeScript-to-native compiler. Closes the Android half of PerryTS/perry#537.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryTS/play-billing.git"
  },
  "homepage": "https://github.com/PerryTS/play-billing#readme",
  "bugs": {
    "url": "https://github.com/PerryTS/perry/issues"
  },
  "keywords": [
    "perry",
    "perryts",
    "play-billing",
    "billing-client",
    "in-app-purchase",
    "iap",
    "android",
    "subscriptions"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src/",
    "crate-android/Cargo.toml",
    "crate-android/src/",
    "crate-stub/Cargo.toml",
    "crate-stub/src/",
    "android/play-billing-bridge.aar",
    "android/build.gradle.kts",
    "android/settings.gradle.kts",
    "android/src/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "perry": {
    "nativeLibrary": {
      "abiVersion": "0.5",
      "functions": [
        { "name": "js_play_billing_load_products",    "params": ["string"], "returns": "promise" },
        { "name": "js_play_billing_purchase",         "params": ["string"], "returns": "promise" },
        { "name": "js_play_billing_query_purchases",  "params": [],         "returns": "promise" },
        { "name": "js_play_billing_has_subscription", "params": [],         "returns": "promise" },
        { "name": "js_play_billing_acknowledge",      "params": ["string"], "returns": "promise" },
        { "name": "js_play_billing_start_listener",   "params": [],         "returns": "void"    }
      ],
      "targets": {
        "android": {
          "crate": "crate-android",
          "lib": "libperry_play_billing.so"
        },
        "ios": {
          "crate": "crate-stub",
          "lib": "libperry_play_billing.a"
        },
        "macos": {
          "crate": "crate-stub",
          "lib": "libperry_play_billing.a"
        },
        "linux": {
          "crate": "crate-stub",
          "lib": "libperry_play_billing.a"
        },
        "windows": {
          "crate": "crate-stub",
          "lib": "libperry_play_billing.a"
        }
      }
    }
  }
}
